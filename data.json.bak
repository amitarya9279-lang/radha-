{"rev":47,"data":{"users":[{"id":"ADM0001","u":"admin","name":"Super Admin","role":"admin","hash":"460589dac89ccc9fdeb9abf37cedb4b94c7ae5af0cf8e14c7285c8cbcf1f1f9a","wallet":0,"services":["ALL"],"loginCount":6,"lastLogin":"7/11/2026, 9:26:49 am"},{"id":"CUS0001","u":"amit","name":"amit","mobile":"9279971975","role":"customer","hash":"2b85654ce8654c92e721edcb5004eab4b24fc1fc34602922e170508525ca6203","wallet":320,"loginCount":8,"lastLogin":"7/11/2026, 9:27:57 am","created":"4/11/2026, 11:07:55 pm"}],"services":[{"id":"SRV0001","name":"Learning License Request","price":80,"icon":"🚗","cat":"PRINT","on":true,"fields":[{"label":"Application Number","type":"text","placeholder":"App****6545","hint":"Enter your LL Application Number","req":true},{"label":"Password","type":"password","placeholder":"Enter Password","hint":"SMS me mila password darj karein","req":true},{"label":"Date Of Birth","type":"date","placeholder":"01/01/2000","hint":"Format: DD/MM/YYYY","req":true},{"label":"Exam Pin (Optional)","type":"text","placeholder":"Enter Exam Pin","hint":"Only for Non-Aadhaar Mode","req":false},{"label":"Select State","type":"dropdown","opts":"-- Select Your State --,Bihar,Jharkhand,Uttar Pradesh,Delhi,West Bengal","hint":"Apna State chunein","req":true}],"instructions":["Video dekhna anivarya hai: Data lagane se pehle test instructions dhyan se padhein.","Password: SMS dwara prapt sahi password hi darj karein.","Duplicate Data Warning: Ek hi application number bar-bar lagane par penalty lag sakti hai.","Approval Time: Data process hone ka samay 15 se 30 minute hai."],"placement":"quick","group":"","chip":"exam","serverLabel":"","badge":"","iconUrl":"","sort":10,"endpoints":[]},{"name":"ll exam","price":60,"icon":"📄","iconUrl":"https://cdn-icons-png.flaticon.com/512/1041/1041888.png","cat":"PRINT","chip":"manual","placement":"quick","group":"","serverLabel":"","badge":"PRO","sort":100,"on":true,"fields":[{"label":"application number","type":"text","placeholder":"","hint":"","opts":"","req":false},{"label":"dob","type":"text","placeholder":"","hint":"","opts":"","req":false},{"label":"password","type":"text","placeholder":"","hint":"","opts":"","req":false},{"label":"state","type":"text","placeholder":"","hint":"","opts":"","req":false}],"instructions":[],"endpoints":[],"id":"SRV0020"}],"orders":[],"pays":[{"id":"PAY0001","uid":"CUS0001","uname":"amit","amt":320,"utr":"DFASFQRF","status":"Completed","t":"7/11/2026, 9:20:01 am","doneBy":"admin","doneAt":"7/11/2026, 9:20:28 am"}],"seq":{"CUS":2,"STF":1,"SRV":21,"ORD":1,"PAY":2,"TKT":1,"LED":2},"settings":{"title":"PDF PRINT PORTAL","sub":"India ka sabse tez Print Portal — Fast, safe aur sasti document delivery.","notice":"Password bhul gaye hain? Forgot Password par click karein. Naye updates aur link ke liye Telegram se zaroor judein.","upi":"merchant@upi","qr":"","tgBotToken":"","tgChatId":"","waLink":"","waWebhook":"","waApiKey":"","notifyOrder":true,"notifyDeposit":true,"notifyComplaint":true,"tickerOn":false,"tickerText":"","tickerSpeed":40,"popupOn":false,"popupTitle":"","popupMsg":"","popupBtnText":"","popupBtnLink":"","popupDismiss":"session","popupVer":1,"customCss":"/* ================= PREMIUM SERVICES COLUMN & CARDS STYLING ================= */\n.premium-services-wrapper {\n  margin: 18px 0 24px 0 !important;\n  display: flex !important;\n  flex-direction: column !important;\n  align-items: center !important;\n  width: 100% !important;\n}\n\n.prem-head-banner {\n  text-align: center !important;\n  margin-bottom: 16px !important;\n}\n\n.prem-title-pill {\n  display: inline-flex !important;\n  align-items: center !important;\n  gap: 8px !important;\n  background: linear-gradient(90deg, #ea580c, #f97316) !important;\n  color: #ffffff !important;\n  font-weight: 900 !important;\n  font-size: 13.5px !important;\n  padding: 8px 22px !important;\n  border-radius: 99px !important;\n  box-shadow: 0 4px 14px rgba(234, 88, 12, 0.4) !important;\n  letter-spacing: 0.4px !important;\n}\n\n.prem-live-tag {\n  background: #ef4444 !important;\n  color: #ffffff !important;\n  font-size: 10px !important;\n  font-weight: 900 !important;\n  padding: 2px 7px !important;\n  border-radius: 99px !important;\n  animation: pulseLive 1.5s infinite !important;\n}\n\n@keyframes pulseLive {\n  0%, 100% { opacity: 1; transform: scale(1); }\n  50% { opacity: 0.75; transform: scale(0.95); }\n}\n\n.prem-sub-txt {\n  font-size: 11.5px !important;\n  color: #64748b !important;\n  font-weight: 700 !important;\n  margin-top: 6px !important;\n}\n\n/* Grid Layout */\n.prem-cards-grid {\n  display: grid !important;\n  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)) !important;\n  gap: 12px !important;\n  width: 100% !important;\n}\n\n/* Individual Premium Card */\n.prem-card-box {\n  background: #ffffff !important;\n  border: 1.5px solid #e2e8f0 !important;\n  border-radius: 16px !important;\n  display: flex !important;\n  flex-direction: column !important;\n  justify-content: space-between !important;\n  position: relative !important;\n  overflow: hidden !important;\n  box-shadow: 0 3px 12px rgba(0, 0, 0, 0.04) !important;\n  transition: all 0.2s ease !important;\n  cursor: pointer !important;\n}\n\n.prem-card-box:hover {\n  transform: translateY(-4px) !important;\n  box-shadow: 0 10px 24px rgba(0, 0, 0, 0.09) !important;\n}\n\n/* Top Badge (NEW / TOP RATED) */\n.prem-badge-top {\n  position: absolute !important;\n  top: -2px !important;\n  right: 12px !important;\n  color: #ffffff !important;\n  font-size: 9px !important;\n  font-weight: 900 !important;\n  padding: 3px 7px !important;\n  border-bottom-left-radius: 6px !important;\n  border-bottom-right-radius: 6px !important;\n  text-transform: uppercase !important;\n}\n.prem-badge-new { background: #ef4444 !important; }\n.prem-badge-toprated { background: #eab308 !important; }\n\n/* Upper Content (Icon + Text) */\n.prem-card-body {\n  padding: 14px 12px 10px 12px !important;\n  display: flex !important;\n  align-items: center !important;\n  gap: 10px !important;\n}\n\n.prem-icon-wrap {\n  width: 48px !important;\n  height: 48px !important;\n  min-width: 48px !important;\n  border-radius: 12px !important;\n  display: grid !important;\n  place-items: center !important;\n  font-size: 24px !important;\n  box-shadow: 0 2px 8px rgba(0,0,0,0.06) !important;\n}\n\n.prem-info {\n  display: flex !important;\n  flex-direction: column !important;\n  text-align: left !important;\n}\n\n.prem-info b {\n  font-size: 12.5px !important;\n  font-weight: 800 !important;\n  color: #0f172a !important;\n  line-height: 1.25 !important;\n}\n\n.prem-info small {\n  font-size: 10.5px !important;\n  color: #64748b !important;\n  margin-top: 3px !important;\n  font-weight: 600 !important;\n}\n\n.prem-info .dot-status {\n  color: #10b981 !important;\n  font-weight: 900 !important;\n  margin-right: 3px !important;\n}\n\n/* Bottom Action / Dropdown Button */\n.prem-action-btn {\n  border: none !important;\n  color: #ffffff !important;\n  font-size: 11px !important;\n  font-weight: 800 !important;\n  padding: 8px 10px !important;\n  display: flex !important;\n  align-items: center !important;\n  justify-content: space-between !important;\n  border-bottom-left-radius: 14px !important;\n  border-bottom-right-radius: 14px !important;\n  cursor: pointer !important;\n  transition: filter 0.15s ease !important;\n}\n\n.prem-action-btn:hover {\n  filter: brightness(1.1) !important;\n}\n\n/* Color Varieties matching image */\n.prem-theme-pink { border-color: #fbcfe8 !important; }\n.prem-theme-pink .prem-icon-wrap { background: linear-gradient(135deg, #f43f5e, #be185d) !important; color:#fff !important; }\n.prem-theme-pink .prem-action-btn { background: #be185d !important; }\n\n.prem-theme-yellow { border-color: #fef08a !important; }\n.prem-theme-yellow .prem-icon-wrap { background: linear-gradient(135deg, #fbbf24, #f59e0b) !important; color:#fff !important; }\n.prem-theme-yellow .prem-action-btn { background: #d97706 !important; }\n\n.prem-theme-blue { border-color: #bfdbfe !important; }\n.prem-theme-blue .prem-icon-wrap { background: linear-gradient(135deg, #38bdf8, #2563eb) !important; color:#fff !important; }\n.prem-theme-blue .prem-action-btn { background: #1d4ed8 !important; }\n\n.prem-theme-green { border-color: #bbf7d0 !important; }\n.prem-theme-green .prem-icon-wrap { background: linear-gradient(135deg, #34d399, #059669) !important; color:#fff !important; }\n.prem-theme-green .prem-action-btn { background: #047857 !important; }\n\n.prem-theme-orange { border-color: #fed7aa !important; }\n.prem-theme-orange .prem-icon-wrap { background: linear-gradient(135deg, #fb923c, #ea580c) !important; color:#fff !important; }\n.prem-theme-orange .prem-action-btn { background: #c2410c !important; }\n\n.prem-theme-purple { border-color: #e9d5ff !important; }\n.prem-theme-purple .prem-icon-wrap { background: linear-gradient(135deg, #c084fc, #7e22ce) !important; color:#fff !important; }\n.prem-theme-purple .prem-action-btn { background: #6b21a8 !important; }","customHtml":"<!-- PREMIUM SERVICES BANNER & GRID SECTION -->\n<div id=\"premiumServicesSection\" class=\"premium-services-wrapper\" style=\"display:none;\">\n  <div class=\"prem-head-banner\">\n    <div class=\"prem-title-pill\">\n      <span>⚡ PREMIUM SERVICES — WORKING INSTANT</span>\n      <span class=\"prem-live-tag\">● LIVE</span>\n    </div>\n    <div class=\"prem-sub-txt\">Card par click karke server / service chunein — sab instant working</div>\n  </div>\n\n  <!-- Dynamic Premium Grid Cards Container -->\n  <div id=\"premiumServicesGrid\" class=\"prem-cards-grid\">\n    <!-- Dynamic Cards will be rendered here automatically -->\n  </div>\n</div>","customJs":"// Sample Pre-added Service agar list me na ho\nfunction ensureSamplePremiumService() {\n  if (typeof D === 'undefined') return;\n  if (!D.services) D.services = [];\n\n  const exists = D.services.find(s => s.id === 'sample_eid_aadhaar');\n  if (!exists) {\n    D.services.unshift({\n      id: 'sample_eid_aadhaar',\n      name: 'Instant EID Aadhaar Card Download',\n      cat: 'Aadhaar Services',\n      price: 25,\n      icon: '🆔',\n      isPremiumCard: true,\n      badgeText: 'NEW',\n      subText: '5 Servers — Instant Working',\n      btnText: 'Choose Server (5)',\n      themeColor: 'pink',\n      fields: [\n        { label: 'EID Number / Enrollment No', type: 'text', req: true },\n        { label: 'Date & Time', type: 'text', req: true }\n      ]\n    });\n    if (typeof syncRemote === 'function') syncRemote(true);\n  }\n}\n\n// 1. Render Premium Services Column On Dashboard\nfunction renderPremiumCardsColumn() {\n  const container = document.getElementById('premiumServicesSection');\n  const grid = document.getElementById('premiumServicesGrid');\n  if (!container || !grid) return;\n\n  if (typeof view !== 'undefined' && view !== 'dash') {\n    container.style.display = 'none';\n    return;\n  }\n\n  const services = (typeof D !== 'undefined' && D.services) ? D.services : [];\n  const premiumList = services.filter(s => s.isPremiumCard);\n\n  if (!premiumList.length) {\n    container.style.display = 'none';\n    return;\n  }\n\n  container.style.display = 'flex';\n\n  let html = '';\n  premiumList.forEach(s => {\n    const theme = s.themeColor || 'blue';\n    const badgeHtml = s.badgeText \n      ? `<span class=\"prem-badge-top prem-badge-${s.badgeText.toLowerCase().replace(/\\s+/g,'')}\">${s.badgeText}</span>` \n      : '';\n\n    html += `\n      <div class=\"prem-card-box prem-theme-${theme}\" onclick=\"openServiceOrderModal('${s.id}')\">\n        ${badgeHtml}\n        <div class=\"prem-card-body\">\n          <div class=\"prem-icon-wrap\">${s.icon || '⚡'}</div>\n          <div class=\"prem-info\">\n            <b>${esc(s.name)}</b>\n            <small><span class=\"dot-status\">●</span> ${esc(s.subText || 'Instant Working')}</small>\n          </div>\n        </div>\n        <button type=\"button\" class=\"prem-action-btn\">\n          <span>📂 ${esc(s.btnText || 'Choose Service')}</span>\n          <span>⌵</span>\n        </button>\n      </div>\n    `;\n  });\n\n  grid.innerHTML = html;\n\n  // Search box ya 4 big cards ke upar position karna\n  const anchor = document.querySelector('.search-banner') || document.querySelector('.feat-grid');\n  if (anchor && anchor.parentElement && container.parentElement !== anchor.parentElement) {\n    anchor.parentElement.insertBefore(container, anchor);\n  }\n}\n\n// 2. Admin Modal me \"Is Premium Card Style?\" Checkbox & Options Inject Karna\nfunction injectAdminPremiumOptions() {\n  const form = document.querySelector('#serviceForm') || document.querySelector('#serviceModal form');\n  if (!form || document.getElementById('adm_is_premium_chk')) return;\n\n  const box = document.createElement('div');\n  box.id = 'adm_is_premium_chk';\n  box.style.cssText = 'background:#161b22;border:1px solid #30363d;padding:12px;border-radius:10px;margin-top:10px;';\n  box.innerHTML = `\n    <label style=\"display:flex;align-items:center;gap:8px;font-weight:800;color:#f0f6fc;cursor:pointer;\">\n      <input type=\"checkbox\" id=\"chk_prem_style\" onchange=\"document.getElementById('prem_extra_fields').style.display=this.checked?'block':'none'\">\n      ⚡ Is Premium Banner Card Style?\n    </label>\n    <div id=\"prem_extra_fields\" style=\"display:none;margin-top:10px;padding-top:10px;border-top:1px dashed #30363d;\">\n      <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:8px;\">\n        <div>\n          <small style=\"color:#8b949e;display:block;margin-bottom:4px;\">Subtext (e.g. 5 Instant Servers):</small>\n          <input type=\"text\" id=\"inp_prem_sub\" placeholder=\"5 Instant Servers\" class=\"inp\" style=\"font-size:11px;\">\n        </div>\n        <div>\n          <small style=\"color:#8b949e;display:block;margin-bottom:4px;\">Button Label (e.g. Choose Server):</small>\n          <input type=\"text\" id=\"inp_prem_btn\" placeholder=\"Choose Server (5)\" class=\"inp\" style=\"font-size:11px;\">\n        </div>\n      </div>\n      <div style=\"display:grid;grid-template-columns:1fr 1fr;gap:8px;\">\n        <div>\n          <small style=\"color:#8b949e;display:block;margin-bottom:4px;\">Top Badge (NEW / TOP RATED):</small>\n          <input type=\"text\" id=\"inp_prem_badge\" placeholder=\"NEW\" class=\"inp\" style=\"font-size:11px;\">\n        </div>\n        <div>\n          <small style=\"color:#8b949e;display:block;margin-bottom:4px;\">Theme Color:</small>\n          <select id=\"sel_prem_color\" class=\"inp\" style=\"font-size:11px;\">\n            <option value=\"pink\">Pink / Rose</option>\n            <option value=\"yellow\">Yellow / Gold</option>\n            <option value=\"blue\" selected>Blue / Cyan</option>\n            <option value=\"green\">Emerald Green</option>\n            <option value=\"orange\">Orange</option>\n            <option value=\"purple\">Purple</option>\n          </select>\n        </div>\n      </div>\n    </div>\n  `;\n\n  // Submit button se pehle lagana\n  const submitBtn = form.querySelector('button[type=\"submit\"]') || form.querySelector('.btn.g');\n  if (submitBtn) form.insertBefore(box, submitBtn);\n\n  // Hook form submission\n  form.addEventListener('submit', function() {\n    const isPrem = document.getElementById('chk_prem_style')?.checked;\n    if (isPrem && typeof D !== 'undefined' && D.services && D.services[0]) {\n      const s = D.services[0]; // newly added\n      s.isPremiumCard = true;\n      s.subText = document.getElementById('inp_prem_sub').value;\n      s.btnText = document.getElementById('inp_prem_btn').value;\n      s.badgeText = document.getElementById('inp_prem_badge').value;\n      s.themeColor = document.getElementById('sel_prem_color').value;\n    }\n  });\n}\n\n// Auto Setup & Loop\nensureSamplePremiumService();\nsetInterval(() => {\n  renderPremiumCardsColumn();\n  injectAdminPremiumOptions();\n}, 500);"},"complaints":[],"ledger":[{"id":"LED000001","uid":"CUS0001","uname":"amit","type":"deposit","amt":320,"bal":320,"note":"UTR DFASFQRF approved (PAY0001)","by":"admin","ref":"PAY0001","t":"7/11/2026, 9:20:28 am"}]}}